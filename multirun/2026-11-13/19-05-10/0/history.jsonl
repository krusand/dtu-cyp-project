RUN_DIR=multirun/2026-11-13/19-05-10

uv run --no-sync python -c "
import json, glob
base = json.load(open('$RUN_DIR/0/baseline_metrics.json'))
print('Baseline (mean guess) MCC:', round(base['macro_MCC'], 4))
rows = []
for p in glob.glob('$RUN_DIR/*/validation_metrics.json'):
    d = p.rsplit('/', 1)[0]
    c = json.load(open(f'{d}/config.json'))
    v = json.load(open(p))
    h = [json.loads(x) for x in open(f'{d}/history.jsonl')]
    rows.append((
        v['macro_MCC'],
        d.split('/')[-1],
        c['model']['encoder_lr'],
        c['model']['readout_lr'],
        c['train']['batch_size'],
        c['readout']['dropout'],
        [round(x['macro_MCC'], 4) for x in h]
    ))
for r in sorted(rows, reverse=True):
    print(f'best_val={r[0]:.4f} | folder={r[1]:>2} | enc_lr={r[2]} | head_lr={r[3]} | bs={r[4]:>2} | drop={r[5]} | epochs={r[6]}')
"